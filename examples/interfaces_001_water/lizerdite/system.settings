# soapff settings: library clayff (R. T. Cygan, J.-J. Liang, A. G. Kalinichev, J. Phys. Chem. B 108, 1255 (2004)); types and charges in system.data from the references of the library
units real
atom_style full
boundary p p p
pair_style lj/cut/coul/long 10.0
pair_modify mix arithmetic tail no
bond_style harmonic
angle_style harmonic
special_bonds lj/coul 0.0 0.0 0.0
read_data system.data
pair_coeff 1 1 0 0  # ho
pair_coeff 2 2 0 0  # hw
pair_coeff 3 3 9.0298e-07 5.264320525  # mgh
pair_coeff 4 4 0.1554 3.165541325  # ob
pair_coeff 5 5 0.1554 3.165541325  # oh
pair_coeff 6 6 0.1554 3.165541325  # ow
pair_coeff 7 7 1.8405e-06 3.302027009  # st
bond_coeff 1 554.1349 1  # oh-ho
bond_coeff 2 554.1349 1  # ow-hw
angle_coeff 1 30 109.47  # X-oh-ho
angle_coeff 2 45.7696 109.47  # hw-ow-hw
kspace_style pppm 1.0e-5
