# soapff settings: library oplsaa (W. L. Jorgensen, D. S. Maxwell, J. Tirado-Rives, J. Am. Chem. Soc. 118, 11225 (1996); types by SMARTS: C. Klein et al., Comput. Mater. Sci. 167, 215 (2019)); types and charges in system.data from the references of the library
units real
atom_style full
boundary p p p
pair_style lj/cut/coul/long 12.0
pair_modify mix geometric tail yes
bond_style harmonic
angle_style harmonic
dihedral_style fourier
special_bonds lj/coul 0.0 0.0 0.5
read_data ff/system.data
pair_coeff 1 1 0.066 3.5  # opls_157
pair_coeff 2 2 0.03 2.5  # opls_140
pair_coeff 3 3 0 10  # opls_155
pair_coeff 4 4 0.17 3.12  # opls_154
bond_coeff 1 268 1.529  # CT-CT
bond_coeff 2 340 1.09  # CT-HC
bond_coeff 3 320 1.41  # CT-OH
bond_coeff 4 553 0.945  # HO-OH
angle_coeff 1 37.5 110.7  # CT-CT-HC
angle_coeff 2 50 109.5  # CT-CT-OH
angle_coeff 3 55 108.5  # CT-OH-HO
angle_coeff 4 33 107.8  # HC-CT-HC
angle_coeff 5 35 109.5  # HC-CT-OH
dihedral_coeff 1 3 0.1780025096 1 180 0.08699928298 2 0 0.2459996415 3 0  # CT-CT-OH-HO
dihedral_coeff 2 1 0.225 3 0  # HC-CT-OH-HO
dihedral_coeff 3 1 4.532999522 1 0  # OH-CT-CT-OH
dihedral_coeff 4 2 1.195028681e-06 1 0 0.233999761 3 0  # HC-CT-CT-OH
dihedral_coeff 5 1 0.15 3 0  # HC-CT-CT-HC
kspace_style pppm 1.0e-5
