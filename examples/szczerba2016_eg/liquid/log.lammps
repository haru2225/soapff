# liquid ethylene glycol, OPLS-AA (soapff oplsaa_eg), 293 K, 1 bar
include ff/system.settings
# soapff settings: library oplsaa_eg (W. L. Jorgensen, D. S. Maxwell, J. Tirado-Rives, J. Am. Chem. Soc. 118, 11225 (1996); types by SMARTS: C. Klein et al., Comput. Mater. Sci. 167, 215 (2019)); types and charges in system.data from the references of the library
units real
atom_style full
boundary p p p
pair_style lj/cut/coul/long 12.0
pair_modify mix geometric tail yes
bond_style harmonic
angle_style harmonic
dihedral_style fourier
special_bonds lj/coul 0.0 0.0 0.5
read_data ff/system.data
