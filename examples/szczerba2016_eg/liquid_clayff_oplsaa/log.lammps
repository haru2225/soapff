include ff/system.settings
# soapff settings: library clayff_oplsaa_eg (M. Szczerba, A. G. Kalinichev, Clays Clay Miner. 64, 488 (2016)); types and charges in system.data from the references of the library
units real
atom_style full
boundary p p p
pair_style lj/cut/coul/long 8.5
pair_modify mix arithmetic tail no
bond_style harmonic
angle_style harmonic
dihedral_style fourier
special_bonds lj/coul 0.0 0.0 0.5
read_data ff/system.data
