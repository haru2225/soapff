LAMMPS (22 Jul 2025 - Update 4)
# the force field (soapff)
include system.settings
# soapff settings: library clayff (R. T. Cygan, J.-J. Liang, A. G. Kalinichev, J. Phys. Chem. B 108, 1255 (2004)); types and charges in system.data from the references of the library
units real
atom_style full
boundary p p p
pair_style lj/cut/coul/long 10.0
pair_modify mix arithmetic tail no
bond_style harmonic
angle_style harmonic
special_bonds lj/coul 0.0 0.0 0.0
read_data system.data
