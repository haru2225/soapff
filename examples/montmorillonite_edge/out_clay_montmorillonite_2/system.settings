# soapff settings: library clayff_edge (T. R. Underwood, I. C. Bourg, J. Phys. Chem. C 124, 3702 (2020)); types and charges in system.data from the references of the library
units real
atom_style full
boundary p p p
pair_style lj/cut/coul/long 10.0
pair_modify mix arithmetic tail no
bond_style harmonic
angle_style harmonic
special_bonds lj/coul 0.0 0.0 0.0
read_data system.data
pair_coeff 1 1 1.3298e-06 4.2713  # ala
pair_coeff 2 2 1.3298e-06 4.2713  # alb
pair_coeff 3 3 1.3298e-06 4.2713  # ao
pair_coeff 4 4 0 0  # ho
pair_coeff 5 5 9.0298e-07 5.2643  # mga
pair_coeff 6 6 9.0298e-07 5.2643  # mgb
pair_coeff 7 7 9.0298e-07 5.2643  # mgo
pair_coeff 8 8 0.1301 2.6378  # Na
pair_coeff 9 9 0.1554 3.1655  # oaa
pair_coeff 10 10 0.1554 3.1655  # oab
pair_coeff 11 11 0.1554 3.1655  # ob
pair_coeff 12 12 0.1554 3.1655  # obos
pair_coeff 13 13 0.1554 3.1655  # oed
pair_coeff 14 14 0.1554 3.1655  # oh
pair_coeff 15 15 0.1554 3.1655  # ohs
pair_coeff 16 16 0.1554 3.1655  # oma
pair_coeff 17 17 0.1554 3.1655  # omb
pair_coeff 18 18 1.8405e-06 3.302  # st
bond_coeff 1 553.935 1  # oab-ho
bond_coeff 2 553.935 1  # oed-ho
bond_coeff 3 553.935 1  # oh-ho
bond_coeff 4 553.935 1  # ohs-ho
bond_coeff 5 553.935 1  # omb-ho
angle_coeff 1 30.0191 109.47  # X-oab-ho
angle_coeff 2 30.0191 109.47  # X-oed-ho
angle_coeff 3 30.0191 109.47  # X-oh-ho
angle_coeff 4 30.0191 109.47  # X-ohs-ho
angle_coeff 5 30.0191 109.47  # X-omb-ho
angle_coeff 6 800 100  # ala-X-ala
angle_coeff 7 800 100  # ala-X-ao
angle_coeff 8 800 100  # ala-X-mga
angle_coeff 9 800 100  # ala-X-mgb
angle_coeff 10 800 100  # ala-X-mgo
angle_coeff 11 800 100  # alb-X-ala
angle_coeff 12 800 100  # alb-X-ao
angle_coeff 13 800 100  # alb-X-mga
angle_coeff 14 800 100  # alb-X-mgo
angle_coeff 15 800 100  # mga-X-ao
angle_coeff 16 800 100  # mgb-X-ao
kspace_style pppm 1.0e-5
